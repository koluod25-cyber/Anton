name: Build Anton Service POS APK (Release)

on:
  workflow_dispatch:
  push:
    branches: [main]
    tags: ['v*']

permissions:
  contents: read

jobs:
  build-release:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Setup Node.js
        uses: actions/setup-node@v4
        with:
          node-version: 22

      - name: Enable Corepack
        run: corepack enable

      - name: Setup pnpm cache
        uses: actions/cache@v4
        with:
          path: |
            ~/.local/share/pnpm/store
            node_modules
          key: ${{ runner.os }}-pnpm-${{ hashFiles('pnpm-lock.yaml') }}
          restore-keys: |
            ${{ runner.os }}-pnpm-

      - name: Install dependencies
        run: pnpm install --frozen-lockfile

      - name: Type check
        run: pnpm check

      - name: Build web
        run: pnpm build

      # Capacitor setup
      - name: Install Capacitor tooling
        run: pnpm add -D @capacitor/cli @capacitor/core @capacitor/android

      - name: Initialize Capacitor if missing
        run: |
          if [ ! -f capacitor.config.ts ] && [ ! -f capacitor.config.json ]; then
            npx cap init "Anton Service POS" "com.antonservice.pos" --web-dir dist
          fi
          if [ ! -d android ]; then
            npx cap add android
          fi

      - name: Sync Capacitor
        run: npx cap sync android

      - name: Setup Java
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: '17'
          cache: gradle

      # --- SIGNING SETUP ---
      - name: Decode Keystore
        env:
          KEYSTORE_BASE64: ${{ secrets.ANDROID_KEYSTORE_BASE64 }}
        run: |
          echo "$KEYSTORE_BASE64" | base64 --decode > android/app/release.jks
          ls -lh android/app/release.jks

      - name: Setup Gradle signing properties
        env:
          KEYSTORE_PASSWORD: ${{ secrets.ANDROID_KEYSTORE_PASSWORD }}
          KEY_ALIAS: ${{ secrets.ANDROID_KEY_ALIAS }}
          KEY_PASSWORD: ${{ secrets.ANDROID_KEY_PASSWORD }}
        run: |
          cat <<EOF >> android/gradle.properties
          MYAPP_UPLOAD_STORE_FILE=release.jks
          MYAPP_UPLOAD_KEY_ALIAS=$KEY_ALIAS
          MYAPP_UPLOAD_STORE_PASSWORD=$KEYSTORE_PASSWORD
          MYAPP_UPLOAD_KEY_PASSWORD=$KEY_PASSWORD
          EOF
          cat android/gradle.properties

      - name: Inject signingConfig in build.gradle
        run: |
          # Backup original
          cp android/app/build.gradle android/app/build.gradle.bak
          # Inject signing config if not exist - patch release block
          # This script will make release use our keystore
          python3 << 'PY'
          import pathlib
          p = pathlib.Path("android/app/build.gradle")
          text = p.read_text()

          # Add signingConfigs if not exists
          if "signingConfigs" not in text:
              text = text.replace(
                  "android {",
                  """android {
              signingConfigs {
                  release {
                      storeFile file('release.jks')
                      storePassword project.hasProperty('MYAPP_UPLOAD_STORE_PASSWORD') ? MYAPP_UPLOAD_STORE_PASSWORD : System.getenv("MYAPP_UPLOAD_STORE_PASSWORD")
                      keyAlias project.hasProperty('MYAPP_UPLOAD_KEY_ALIAS') ? MYAPP_UPLOAD_KEY_ALIAS : System.getenv("MYAPP_UPLOAD_KEY_ALIAS")
                      keyPassword project.hasProperty('MYAPP_UPLOAD_KEY_PASSWORD') ? MYAPP_UPLOAD_KEY_PASSWORD : System.getenv("MYAPP_UPLOAD_KEY_PASSWORD")
                  }
              }"""
              )

          # Make release buildType use signingConfig release
          if "signingConfig signingConfigs.release" not in text:
              text = text.replace(
                  "buildTypes {\n        release {",
                  "buildTypes {\n        release {\n            signingConfig signingConfigs.release"
              )

          p.write_text(text)
          print("Patched build.gradle")
          print(text[:3000])
          PY

      - name: Build Release APK
        working-directory: android
        env:
          MYAPP_UPLOAD_STORE_PASSWORD: ${{ secrets.ANDROID_KEYSTORE_PASSWORD }}
          MYAPP_UPLOAD_KEY_ALIAS: ${{ secrets.ANDROID_KEY_ALIAS }}
          MYAPP_UPLOAD_KEY_PASSWORD: ${{ secrets.ANDROID_KEY_PASSWORD }}
        run: ./gradlew assembleRelease --no-daemon

      - name: Rename APK
        run: |
          VERSION=$(jq -r .version package.json 2>/dev/null || echo "1.0.0")
          cp android/app/build/outputs/apk/release/app-release.apk anton-service-pos-v${VERSION}-release.apk
          ls -lh *.apk

      - name: Upload Release APK
        uses: actions/upload-artifact@v4
        with:
          name: anton-service-pos-release-apk
          path: |
            android/app/build/outputs/apk/release/app-release.apk
            anton-service-pos-*.apk
          retention-days: 30

      # Optional: Create GitHub Release if tag pushed
      - name: Create GitHub Release
        if: startsWith(github.ref, 'refs/tags/v')
        uses: softprops/action-gh-release@v2
        with:
          files: |
            android/app/build/outputs/apk/release/app-release.apk
            anton-service-pos-*.apk
